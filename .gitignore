# Entorno y cachés de Python
__pycache__/
*.py[cod]
.venv/
venv/

# Configuración local y credenciales de Streamlit
/.streamlit/*
!/.streamlit/config.toml
!/.streamlit/secrets.toml.example

# Credenciales y tokens OAuth de Google
.secrets/
client_secret*.json
credentials*.json
token*.json
oauth_pending*.json
user_preferences*.json
secrets.toml

# Base de datos local de tareas
.data/
# Documentos académicos y sus metadatos locales
.data/academic_documents/
*.db
*.db-shm

# MOONA Connect: compilación y archivos locales
/.moona-connect-build/
**/com.moona.connect.json
**/indicators.db-journal
*.db-wal

# Variables de entorno y archivos del editor
.env
.env.*
.vscode/
.idea/

*.pem
*.key
*.p12
*.pfx
