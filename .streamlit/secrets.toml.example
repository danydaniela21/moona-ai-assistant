# Copia este archivo como .streamlit/secrets.toml.
# Descarga el JSON OAuth de Google en la ruta indicada. Ambos quedan fuera de Git.

GEMINI_API_KEY = "TU-API-KEY-DE-GEMINI"
GROQ_API_KEY = "TU-API-KEY-DE-GROQ"

[google]
credentials_file = ".streamlit/credentials.json"
token_file = ".streamlit/token.json"
pending_file = ".streamlit/oauth_pending.json"
redirect_uri = "http://localhost:8501"
